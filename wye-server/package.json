{
  "name": "wye-server",
  "version": "1.0.0",
  "private": true,
  "description": "WYE 物业收费管理系统 - Node.js 后端（Fastify + Prisma + SQLite），同时托管前端静态资源",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
