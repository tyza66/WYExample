# WYE 后端环境变量样例（复制为 .env 或直接在部署平台配置）

# 服务监听端口与地址
PORT=8080
HOST=0.0.0.0

# SQLite 数据库文件位置（相对 prisma/schema.prisma 所在目录解析）
# 本地默认落在 wye-server/data/wye.db；Docker 里建议用绝对路径
DATABASE_URL=file:../data/wye.db

# JWT 签名密钥：生产环境必须改成足够长的随机串
WYE_JWT_SECRET=wye-dev-secret-change-me

# 是否在库为空时自动灌入演示数据（生产环境建议 false）
WYE_SEED=true

# 启动时是否自动建表/同步表结构（Docker 构建阶段已建表时可设 false）
WYE_AUTO_MIGRATE=true

# 前端构建产物目录：存在时由本进程直接托管页面并做 SPA 回退
# 本地默认自动探测 ../wye-frontend/dist；Docker 里为 /app/web
WYE_WEB_DIST=
