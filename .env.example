# 一站式启动的可覆盖变量（docker compose 会自动读取同目录 .env）
# 复制为 .env 后按需修改；生产环境至少要改掉 WYE_JWT_SECRET

# 对外端口
PORT=8080

# JWT 签名密钥：必须是足够长的随机串
WYE_JWT_SECRET=change-me-in-production

# 是否自动灌演示数据（正式使用请改为 false）
WYE_SEED=true

# 启动时是否自动建表
WYE_AUTO_MIGRATE=true

# SQLite 数据库文件位置（容器内绝对路径）
DATABASE_URL=file:/app/wye-server/data/wye.db

# 时区
TZ=Asia/Shanghai
