root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,yml,yaml,properties}]
indent_style = space
indent_size = 4

[*.{js,vue,json,ts,css,scss,html,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
